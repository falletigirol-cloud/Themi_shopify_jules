<div class="py-16 md:py-24">
  <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12 text-center flex flex-col items-center gap-6">
    <h2 class="text-burnt-sienna text-3xl font-bold leading-tight tracking-tight md:text-4xl max-w-2xl font-playfair">
      {{ section.settings.title }}
    </h2>
    <p class="text-sage-green text-base font-normal leading-normal max-w-xl font-lato">
      {{ section.settings.subtitle }}
    </p>
    <a href="{{ section.settings.button_link }}" class="btn btn-primary h-12 px-6 text-base font-bold">
      <span class="truncate">{{ section.settings.button_text }}</span>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Community CTA",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Connect with Fellow Beauty Enthusiasts"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Share your experiences, ask questions, and discover new tips and tricks in our vibrant community."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Join the Community"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Community CTA"
    }
  ]
}
{% endschema %}
