<div class="flex items-center justify-center min-h-screen">
  <div class="text-center">
    <h1 class="text-5xl font-black leading-tight tracking-[-0.033em] text-burnt-sienna font-playfair">Coming Soon</h1>
    <p class="text-lg font-normal leading-normal text-sage-green max-w-2xl mx-auto mt-4">{{ shop.password_message }}</p>
    {% form 'customer' %}
      {{ form.errors | default_errors }}
      {% if form.posted_successfully? %}
        <p class="text-lg text-sage-green mt-4">Thank you for subscribing!</p>
      {% else %}
        <div class="flex items-center max-w-md mx-auto mt-8">
          <input type="email" name="contact[email]" placeholder="Your email" class="form-input">
          <button type="submit" class="btn btn-primary ml-2">Notify Me</button>
        </div>
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password Template",
  "settings": []
}
{% endschema %}
