<section class="py-16 md:py-24 bg-beige">
  <div class="flex flex-col gap-8 text-center">
    <h2 class="text-burnt-sienna text-3xl font-bold leading-tight tracking-tight md:text-4xl font-playfair">{{ section.settings.title }}</h2>
    <div class="flex overflow-x-auto [-ms-scrollbar-style:none] [scrollbar-width:none] [&amp;::-webkit-scrollbar]:hidden -mx-4 px-4">
      <div class="flex items-stretch p-4 gap-6">
        {% for block in section.blocks %}
          <div class="card flex h-full flex-1 flex-col gap-4 p-4 min-w-64">
            {% form 'product', block.settings.product %}
              <input type="hidden" name="id" value="{{ block.settings.product.variants.first.id }}">
              <div class="w-full bg-center bg-no-repeat aspect-[3/4] bg-cover rounded-lg flex flex-col group overflow-hidden" style="background-image: url('{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{% case forloop.index %}{% when 1 %}{{ 'https://images.pexels.com/photos/7262911/pexels-photo-7262911.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2' }}{% when 2 %}{{ 'https://images.pexels.com/photos/7262898/pexels-photo-7262898.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2' }}{% when 3 %}{{ 'https://images.pexels.com/photos/7262905/pexels-photo-7262905.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2' }}{% else %}{{ 'https://images.pexels.com/photos/7262893/pexels-photo-7262893.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2' }}{% endcase %}{% endif %}');">
                <div class="mt-auto p-4 bg-black/20 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <button type="submit" name="add" class="btn btn-primary w-full h-10 font-bold" data-add-to-cart>Quick Add</button>
                </div>
              </div>
              <div class="text-left">
                <a href="{{ block.settings.product.url }}" class="text-burnt-sienna text-base font-medium leading-normal font-playfair">{{ block.settings.product.title }}</a>
                <p class="text-sage-green text-sm font-normal leading-normal font-lato">{{ block.settings.product.description | strip_html | truncatewords: 10 }}</p>
                <p class="text-burnt-sienna text-base font-bold mt-1">{{ block.settings.product.price | money }}</p>
              </div>
            {% endform %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Best Sellers"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestsellers",
      "category": "Content",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "product_title": "Organic Rosehip Oil",
            "product_description": "Nourishing oil for radiant skin",
            "product_price": "$24.99"
          }
        },
        {
          "type": "product",
          "settings": {
            "product_title": "Natural Clay Mask",
            "product_description": "Detoxifying mask for a clear complexion",
            "product_price": "$19.99"
          }
        },
        {
          "type": "product",
          "settings": {
            "product_title": "Botanical Cleansing Balm",
            "product_description": "Gentle cleanser for all skin types",
            "product_price": "$29.99"
          }
        },
        {
          "type": "product",
          "settings": {
            "product_title": "Herbal Infused Toner",
            "product_description": "Refreshing toner with natural extracts",
            "product_price": "$18.99"
          }
        }
      ]
    }
  ]
}
{% endschema %}
