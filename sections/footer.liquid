<footer class="bg-beige text-burnt-sienna font-lato">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <div class="flex items-center gap-4">
        <svg class="h-8 w-8 text-sage-green" fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z" fill="currentColor"></path>
        </svg>
        <h2 class="text-xl font-bold font-playfair">{{ shop.name }}</h2>
      </div>
      <nav class="flex flex-wrap justify-center gap-6 text-base font-medium">
        {% for link in linklists.footer.links %}
          <a class="hover:text-sage-green transition-colors" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
      <p class="text-center text-base text-burnt-sienna/70">© {{ "now" | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
