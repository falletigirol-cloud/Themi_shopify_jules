<div class="w-full relative">
  <video autoplay muted loop class="absolute inset-0 w-full h-full object-cover">
    <source src="{{ 'G002_hero_video.mp4' | asset_url }}" type="video/mp4">
  </video>
  <div class="relative flex min-h-[560px] flex-col gap-6 bg-black/50 rounded-2xl items-start justify-end px-6 pb-10 md:px-12 md:pb-12">
    <div class="flex flex-col gap-4 text-left max-w-xl">
      <h1 class="text-white text-4xl font-bold leading-tight tracking-tight md:text-5xl lg:text-6xl font-playfair">
        {{ section.settings.title }}
      </h1>
      <h2 class="text-white text-base font-normal leading-normal md:text-lg font-lato">
        {{ section.settings.subtitle }}
      </h2>
    </div>
    <div class="flex-wrap gap-4 flex">
      <a href="{{ section.settings.button_1_link }}" class="btn btn-primary h-12 px-6 text-base font-bold">
        <span class="truncate">{{ section.settings.button_1_text }}</span>
      </a>
      <a href="{{ section.settings.button_2_link }}" class="btn btn-secondary h-12 px-6 text-base font-bold">
        <span class="truncate">{{ section.settings.button_2_text }}</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Bellezza è Benessere, Dentro e Fuori"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Prodotti bio curati per la tua pelle. Una community vibrante per la tua autostima."
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 Text",
      "default": "Scopri la VeroBioBox"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 Text",
      "default": "Unisciti alla Community"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
