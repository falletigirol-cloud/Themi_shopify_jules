<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center gap-2 text-sm text-sage-green mb-8">
    <a class="hover:text-burnt-sienna" href="/">Home</a>
    <span>/</span>
    <a class="hover:text-burnt-sienna" href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    <span>/</span>
    <span class="text-burnt-sienna">{{ product.title }}</span>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
    <div class="grid grid-cols-[100px_1fr] gap-4">
      <div class="flex flex-col gap-4">
        {% for image in product.images %}
          <img alt="{{ image.alt | escape }}" class="rounded-lg cursor-pointer border-2 {% if forloop.first %}border-sage-green shadow-lg{% else %}border-transparent hover:border-sage-green transition-colors{% endif %}" src="{{ image | img_url: 'master' }}">
        {% endfor %}
      </div>
      <div class="w-full h-[600px] rounded-2xl bg-cover bg-center shadow-2xl" style="background-image: url('{{ product.featured_image | img_url: 'master' }}');"></div>
    </div>
    <div class="space-y-8 bg-white p-8 rounded-2xl shadow-lg">
      <div>
        <h1 class="text-5xl font-bold text-burnt-sienna tracking-tight font-playfair">{{ product.title }}</h1>
        <p class="text-lg text-sage-green mt-2 font-lato">{{ product.description }}</p>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-0.5 text-sage-green">
          {% for i in (1..5) %}
            {% if i <= 4 %}
              <svg fill="currentColor" height="22px" viewBox="0 0 256 256" width="22px" xmlns="http://www.w3.org/2000/svg"><path d="M234.5,114.38l-45.1,39.36,13.51,58.6a16,16,0,0,1-23.84,17.34l-51.11-31-51,31a16,16,0,0,1-23.84-17.34L66.61,153.8,21.5,114.38a16,16,0,0,1,9.11-28.06l59.46-5.15,23.21-55.36a15.95,15.95,0,0,1,29.44,0h0L166,81.17l59.44,5.15a16,16,0,0,1,9.11,28.06Z"></path></svg>
            {% else %}
              <svg class="text-light-gray" fill="currentColor" height="22px" viewBox="0 0 256 256" width="22px" xmlns="http://www.w3.org/2000/svg"><path d="M239.2,97.29a16,16,0,0,0-13.81-11L166,81.17,142.72,25.81h0a15.95,15.95,0,0,0-29.44,0L90.07,81.17,30.61,86.32a16,16,0,0,0-9.11,28.06L66.61,153.8,53.09,212.34a16,16,0,0,0,23.84,17.34l51-31,51.11,31a16,16,0,0,0,23.84-17.34l-13.51-58.6,45.1-39.36A16,16,0,0,0,239.2,97.29Zm-15.22,5-45.1,39.36a16,16,0,0,0-5.08,15.71L187.35,216v0l-51.07-31a15.9,15.9,0,0,0-16.54,0l-51,31h0L82.2,157.4a16,16,0,0,0-5.08-15.71L32,102.35a.37.37,0,0,1,0-.09l59.44-5.14a16,16,0,0,0,13.35-9.75L128,32.08l23.2,55.29a16,16,0,0,0,13.35,9.75L224,102.26S224,102.32,224,102.33Z"></path></svg>
            {% endif %}
          {% endfor %}
        </div>
        <span class="text-sage-green text-base font-medium font-lato">(120 recensioni)</span>
      </div>
      <p class="text-base text-burnt-sienna leading-relaxed font-lato">{{ product.description | strip_html | truncatewords: 30 }}</p>
      <div class="border-t border-b border-light-gray py-6 space-y-4">
        <div class="flex justify-between items-center">
          <p class="text-4xl font-bold text-burnt-sienna">{{ product.price | money }}</p>
          <span class="inline-flex items-center rounded-full bg-beige px-3 py-1 text-sm font-semibold text-sage-green">{% if product.available %}Disponibile{% else %}Esaurito{% endif %}</span>
        </div>
        {% form 'product', product %}
          <div class="flex items-center gap-4">
            <p class="text-sm font-medium text-burnt-sienna font-lato">Quantità:</p>
            <div class="flex items-center border border-light-gray rounded-lg">
              <button type="button" class="quantity-button px-3 py-1 text-lg text-gray-500 hover:bg-beige rounded-l-lg" data-action="decrement">-</button>
              <input class="form-input quantity-input px-4 py-1 text-base font-medium w-12 text-center" type="number" name="quantity" value="1" min="1">
              <button type="button" class="quantity-button px-3 py-1 text-lg text-gray-500 hover:bg-beige rounded-r-lg" data-action="increment">+</button>
            </div>
          </div>
          <div class="mt-8 flex flex-col gap-4">
            <button type="submit" name="add" class="btn btn-primary w-full h-14 text-lg font-bold">
              Aggiungi al carrello
            </button>
          </div>
        {% endform %}
      </div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quantityButtons = document.querySelectorAll('.quantity-button');
    quantityButtons.forEach(button => {
      button.addEventListener('click', function() {
        const action = this.dataset.action;
        const input = this.parentElement.querySelector('.quantity-input');
        let value = parseInt(input.value);
        if (action === 'increment') {
          value++;
        } else {
          value = value > 1 ? value - 1 : 1;
        }
        input.value = value;
      });
    });
  });
</script>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Template",
  "settings": []
}
{% endschema %}
