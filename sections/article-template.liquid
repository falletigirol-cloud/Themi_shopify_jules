<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-burnt-sienna font-playfair mb-4">{{ article.title }}</h1>
    <div class="flex items-center gap-4 text-sm text-sage-green mb-8">
      <span>{{ article.published_at | date: "%B %d, %Y" }}</span>
      <span>by {{ article.author }}</span>
    </div>
    <div class="prose prose-lg text-sage-green mx-auto">
      {{ article.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article Template",
  "settings": []
}
{% endschema %}
